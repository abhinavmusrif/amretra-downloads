#!/bin/bash
set -euo pipefail

echo "Megas Moves Intel macOS DMG logo repair"
echo "======================================"

WORK="$(mktemp -d /tmp/megasmoves-dmg-fix.XXXXXX)"
ATTACHED_BY_SCRIPT=0
MOUNT_POINT=""

cleanup() {
  if [ "$ATTACHED_BY_SCRIPT" = "1" ] && [ -n "$MOUNT_POINT" ] && [ -d "$MOUNT_POINT" ]; then
    hdiutil detach "$MOUNT_POINT" >/dev/null 2>&1 || true
  fi
  rm -rf "$WORK"
}
trap cleanup EXIT

find_app() {
  local p
  for p in \
    "/Volumes/Megas Moves/Megas Moves.app" \
    "/Applications/Megas Moves.app"; do
    if [ -d "$p" ]; then
      printf '%s\n' "$p"
      return 0
    fi
  done
  return 1
}

SRC_APP="$(find_app || true)"

if [ -z "$SRC_APP" ]; then
  DMG="$(find "$HOME/Downloads" -maxdepth 1 -type f \( -name 'MegasMoves*Intel*.dmg' -o -name 'Megas*M*Intel*.dmg' \) -print 2>/dev/null | head -n 1 || true)"
  if [ -z "$DMG" ]; then
    echo "ERROR: Could not find a mounted Megas Moves app or an Intel DMG in ~/Downloads."
    echo "Mount your existing Intel DMG, then run this command again."
    exit 1
  fi

  echo "Mounting existing Intel DMG: $DMG"
  ATTACH_OUTPUT="$(hdiutil attach -nobrowse -readonly "$DMG")"
  MOUNT_POINT="$(printf '%s\n' "$ATTACH_OUTPUT" | awk -F '\t' '/\/Volumes\// {print $NF}' | tail -n 1)"
  ATTACHED_BY_SCRIPT=1
  SRC_APP="$MOUNT_POINT/Megas Moves.app"
fi

if [ ! -d "$SRC_APP" ]; then
  echo "ERROR: Megas Moves.app was not found in the mounted image."
  exit 1
fi

echo "Using app: $SRC_APP"
APP="$WORK/Megas Moves.app"
ditto "$SRC_APP" "$APP"

LOGO="$WORK/MegasMoves-logo.png"
cat > "$WORK/logo.b64" <<'MEGAS_LOGO_B64'

MEGAS_LOGO_B64
/usr/bin/base64 -D "$WORK/logo.b64" > "$LOGO"
test -s "$LOGO"

ICONSET="$WORK/MegasMoves.iconset"
ICNS="$WORK/MegasMoves.icns"
mkdir -p "$ICONSET"

echo "Generating native macOS icon..."
sips -z 16 16     "$LOGO" --out "$ICONSET/icon_16x16.png" >/dev/null
sips -z 32 32     "$LOGO" --out "$ICONSET/icon_16x16@2x.png" >/dev/null
sips -z 32 32     "$LOGO" --out "$ICONSET/icon_32x32.png" >/dev/null
sips -z 64 64     "$LOGO" --out "$ICONSET/icon_32x32@2x.png" >/dev/null
sips -z 128 128   "$LOGO" --out "$ICONSET/icon_128x128.png" >/dev/null
sips -z 256 256   "$LOGO" --out "$ICONSET/icon_128x128@2x.png" >/dev/null
sips -z 256 256   "$LOGO" --out "$ICONSET/icon_256x256.png" >/dev/null
sips -z 512 512   "$LOGO" --out "$ICONSET/icon_256x256@2x.png" >/dev/null
sips -z 512 512   "$LOGO" --out "$ICONSET/icon_512x512.png" >/dev/null
sips -z 1024 1024 "$LOGO" --out "$ICONSET/icon_512x512@2x.png" >/dev/null
iconutil -c icns "$ICONSET" -o "$ICNS"
test -s "$ICNS"

RES="$APP/Contents/Resources"
PLIST="$APP/Contents/Info.plist"
mkdir -p "$RES"
cp "$ICNS" "$RES/MegasMoves.icns"

/usr/libexec/PlistBuddy -c "Delete :CFBundleIconFile" "$PLIST" >/dev/null 2>&1 || true
/usr/libexec/PlistBuddy -c "Add :CFBundleIconFile string MegasMoves.icns" "$PLIST"

echo "Re-signing repaired app..."
codesign --force --deep --sign - "$APP"
codesign --verify --deep --strict --verbose=2 "$APP"

STAGE="$WORK/dmg-stage"
mkdir -p "$STAGE"
ditto "$APP" "$STAGE/Megas Moves.app"
ln -s /Applications "$STAGE/Applications"

OUT="$HOME/Downloads/MegasMoves-latest-macOS-Intel-logo-fixed.dmg"
SHA="$OUT.sha256"
rm -f "$OUT" "$SHA"

echo "Creating corrected Intel DMG..."
hdiutil create \
  -volname "Megas Moves" \
  -srcfolder "$STAGE" \
  -ov \
  -format UDZO \
  "$OUT" >/dev/null

shasum -a 256 "$OUT" > "$SHA"
hdiutil verify "$OUT" >/dev/null

echo
echo "SUCCESS"
echo "Fixed DMG: $OUT"
echo "Checksum:  $SHA"
echo
echo "Opening Downloads..."
open -R "$OUT"
